# Used by docker-compose.yml. Copy to deploy.env (git-ignored) and replace every CHANGE_ME. Never commit real values.
# Everything else in .env.example may be added here too (SMTP_URL, YOUTUBE_API_KEY, SHOPIFY_*, ...).

POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
WORKER_DB_PASSWORD=CHANGE_ME

# Public address users type in the browser (https in production).
APP_BASE_URL=https://app.example.com
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
EMAIL_FROM="Shelfwatch <reports@example.com>"
# Identify your collector honestly and give site owners a way to contact you.
COLLECTOR_USER_AGENT="CompetitorIntelBot/1.0 (+https://app.example.com/bot; respects robots.txt)"
SCHEDULER_MODE=normal
ALLOW_LOCAL_FIXTURES=false
FX_PROVIDER=peg
