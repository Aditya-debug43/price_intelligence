[Unit]
Description=Shelfwatch worker (background jobs, scheduler, retention) - run exactly one
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=shelfwatch
Group=shelfwatch
WorkingDirectory=/opt/shelfwatch/app
EnvironmentFile=/etc/shelfwatch/shelfwatch.env
Environment=HOME=/opt/shelfwatch
ExecStart=/usr/bin/node apps/worker/dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=45
SyslogIdentifier=shelfwatch-worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shelfwatch
OOMScoreAdjust=200
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
