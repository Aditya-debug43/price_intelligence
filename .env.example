# ─────────────────────────────────────────────────────────────────────────────
# Competitor Intelligence — configuration reference.
# Copy to .env (`npm run dev:db` generates one with random local secrets). Never commit real values.
# Configuration is validated at startup (packages/core/src/config.ts); invalid or unsafe values stop the process.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Web / API ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=4000
# Comma-free single origin allowed for browser calls when web and API are on different origins (dev: the Vite proxy makes this unnecessary).
CORS_ORIGIN=
# Serve the built web app from the API process (single-container deployment).
SERVE_WEB=false

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
# API role: subject to Row-Level Security.            (created by `npm run db:setup`)
DATABASE_URL=postgres://ci_app:CHANGE_ME@127.0.0.1:54329/competitor_intel
# Worker role: BYPASSRLS, spans tenants; never exposed to the web tier.
WORKER_DATABASE_URL=postgres://ci_worker:CHANGE_ME@127.0.0.1:54329/competitor_intel
# Owner/admin role: only for migrations and `db:setup`.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@127.0.0.1:54329/competitor_intel

# ── Sessions & secrets ───────────────────────────────────────────────────────
SESSION_TTL_DAYS=14
# Defaults to true in production. Set false only for plain-HTTP local development.
SESSION_COOKIE_SECURE=
# AES-256-GCM key ring for stored integration tokens: "id:base64(32 bytes)[,olderId:base64]". The first key encrypts.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ── Object storage (raw page snapshots, exported files) ──────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# S3-compatible (AWS S3, Cloudflare R2, MinIO…) when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
# Example: smtps://user:pass@smtp.example.com:465. When empty, emails are recorded in the outbox table
# (status "dev_logged") and never leave the machine.
SMTP_URL=
EMAIL_FROM="Shelfwatch <reports@example.com>"

# ── Scheduling ───────────────────────────────────────────────────────────────
# "dev" adds a manual clock/trigger API so the 9:00 AM report flow can be exercised at any time. Forbidden in production.
SCHEDULER_MODE=normal

# ── Collection (crawler) ─────────────────────────────────────────────────────
# Identify the bot honestly and give site owners a way to contact you.
COLLECTOR_USER_AGENT="CompetitorIntelBot/1.0 (+https://your-domain.example/bot; respects robots.txt)"
COLLECTOR_TIMEOUT_MS=20000
COLLECTOR_MAX_HTML_BYTES=3145728
COLLECTOR_MAX_JSON_BYTES=12582912
COLLECTOR_MAX_PDF_BYTES=20971520
COLLECTOR_DEFAULT_DELAY_MS=1500
COLLECTOR_DEFAULT_MAX_REQUESTS=2000
# Allow loopback hosts so local fixture sites can be added. NEVER enable in production (disables part of the SSRF guard).
ALLOW_LOCAL_FIXTURES=false
# Development convenience: auto-confirm collection consent for fixture sites only.
DEMO_AUTO_CONSENT=false
# Headless-browser rendering for JS-only sites (requires `npx playwright-core install chromium` or a system Chrome/Edge).
BROWSER_RENDERING_ENABLED=false
# Which browser to drive: "chrome" (default), "msedge", or leave BROWSER_CHANNEL and set an explicit path to Chrome/Chromium.
BROWSER_CHANNEL=chrome
BROWSER_EXECUTABLE_PATH=

# ── Retention ────────────────────────────────────────────────────────────────
RETENTION_SNAPSHOT_DAYS=90
RETENTION_HISTORY_DAYS=365

# ── Currency ─────────────────────────────────────────────────────────────────
# peg          → explicit, timestamped AWG/USD peg (1.79) only; other currencies are not converted.
# open-er-api  → additionally fetches market rates from open.er-api.com (free; attribution required).
FX_PROVIDER=peg

# ── Optional AI (never required) ─────────────────────────────────────────────
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ── Social integrations (official APIs only) ─────────────────────────────────
# YouTube Data API v3 key (free quota: 10,000 units/day). Public channel uploads.
YOUTUBE_API_KEY=
# Meta (Instagram/Facebook). Reading OTHER accounts' public content needs App Review + Business Verification:
#  - Instagram Business Discovery: an access token for YOUR Instagram professional account + its IG user id.
#  - Facebook public Page content: needs the "Page Public Content Access" feature.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Shopify (optional authorised inventory; read-only scopes) ────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_locations
SHOPIFY_API_VERSION=2026-07
# Must match an allowed redirect URL configured in the Shopify app, e.g. https://app.example.com/api/v1/integrations/shopify/callback
SHOPIFY_REDIRECT_URI=
